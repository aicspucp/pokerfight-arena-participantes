    { "id": "novato",      "nombre": "Michi Novato",          "comando": ["python", "bots/novato/bot.py", "-silencioso"] },
    { "id": "bandido",     "nombre": "Gato Bandido",          "comando": ["./bin/bandido", "-silencioso"] },
